<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MaharashtraTourism" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="statusBarBackground">@color/black</item>
    </style>

    <style name="Theme.MaharashtraTourism" parent="Base.Theme.MaharashtraTourism" />


    <!-- heading name -->
    <style name="heading">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">25sp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="viewbutton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:layout_marginBottom">-9dp</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:src">@drawable/baseline_arrow_circle_right_24</item>
    </style>

    <style name="eventHeading">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">25sp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="inputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/input_layout</item>
        <item name="android:textColorHint">@color/iconColor</item>
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:paddingStart">35dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>

    </style>

</resources>