<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".GuideDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="20dp">

        <!-- Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="15dp"
            android:orientation="vertical"
            android:gravity="center"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/guideProfileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/baseline_person_24"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"/>

            <TextView
                android:id="@+id/guideName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guide Name"
                android:textSize="25sp"
                android:textColor="@color/orange"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/guideExperience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Experience: 5 Years"
                android:textSize="18sp"
                android:layout_marginTop="5dp"
                android:textColor="@color/darker_gray"/>

            <TextView
                android:id="@+id/guideSpecialization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specialization: Historical Tours"
                android:textSize="18sp"
                android:layout_marginTop="5dp"
                android:textColor="@color/darker_gray"/>

            <TextView
                android:id="@+id/guideCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City: Mumbai"
                android:textSize="18sp"
                android:layout_marginTop="5dp"
                android:textColor="@color/darker_gray"/>

            <TextView
                android:id="@+id/guideVerifiedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Not Verified"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_input"
                android:text="Edit Profile"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

