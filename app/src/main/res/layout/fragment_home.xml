<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".HomeFragment">

        <androidx.viewpager2.widget.ViewPager2
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:id="@+id/viewPager"
            android:layout_gravity="clip_horizontal"
            android:clipToPadding="false" />

        <com.google.android.material.tabs.TabLayout
            android:layout_width="wrap_content"
            android:layout_height="5dp"
            android:id="@+id/tabLayout"
            android:layout_below="@id/viewPager"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            app:tabSelectedTextColor="@color/orange"
            android:background="@color/darker_gray"
            app:tabRippleColor="@color/orange"
            app:tabIndicatorHeight="5dp"
            app:tabIndicatorColor="@color/orange"
            android:layout_gravity="center_horizontal|top" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/suggestHeading"
            android:layout_below="@id/tabLayout"
            android:text="@string/suggested_destination"
            style="@style/heading"/>

        <ImageButton
            android:id="@+id/suggestDestMoreBtn"
            android:layout_alignTop="@id/suggestHeading"
            android:layout_alignBottom="@id/suggestHeading"
            style="@style/viewbutton"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/sugest_destination_home"
            android:layout_below="@id/suggestHeading"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/popularFestivalHeading"
            android:layout_below="@id/sugest_destination_home"
            android:text="@string/popularFestival"
            style="@style/heading"/>

        <ImageButton
            android:id="@+id/popularFestivalMoreBtn"
            android:layout_alignTop="@id/popularFestivalHeading"
            android:layout_alignBottom="@+id/popularFestivalHeading"
            style="@style/viewbutton"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/popular_festival_home"
            android:layout_below="@id/popularFestivalHeading"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/exploreHeading"
            android:layout_below="@id/popular_festival_home"
            android:text="@string/explore"
            style="@style/heading"/>

        <ImageButton
            android:id="@+id/exploreMoreBtn"
            android:layout_alignTop="@id/exploreHeading"
            android:layout_alignBottom="@id/exploreHeading"
            style="@style/viewbutton"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/exploreMoreHome"
            android:layout_below="@id/exploreHeading"
            android:layout_marginTop="10dp"/>

    </RelativeLayout>

</androidx.core.widget.NestedScrollView>