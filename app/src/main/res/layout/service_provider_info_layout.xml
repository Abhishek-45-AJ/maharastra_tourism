<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:background="@color/white"
    android:layout_margin="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/input_layout"
        android:padding="10dp">

        <ImageView
            android:id="@+id/guideImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/baseline_person_24"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>

        <TextView
            android:id="@+id/guideName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guide"
            android:textSize="30sp"
            android:textColor="@color/orange"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_below="@id/guideImage"
            android:layout_centerHorizontal="true"/>

        <ImageButton
            android:id="@+id/guideCallBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/number"
            android:background="@drawable/circle_background_icon"
            app:tint="@color/orange"
            android:padding="2dp"
            android:clickable="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:layout_below="@id/guideName"
            android:layout_alignParentStart="true"/>

        <ImageButton
            android:id="@+id/guideMessageBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/baseline_message_24"
            android:background="@drawable/circle_background_icon"
            app:tint="@color/orange"
            android:padding="2dp"
            android:clickable="true"
            android:layout_marginEnd="10dp"
            android:layout_alignTop="@id/guideCallBtn"
            android:layout_alignBottom="@id/guideCallBtn"
            android:layout_alignParentEnd="true"/>

    </RelativeLayout>

</androidx.cardview.widget.CardView>