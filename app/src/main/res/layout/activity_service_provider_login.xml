<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_maharashtra"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/logintxt1"
        android:shadowColor="#808080"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:layout_margin="10dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:text="I don't have an account ?"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/signupTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#808080"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:layout_alignEnd="@id/logintxt1"
        android:layout_below="@id/logintxt1"
        android:text="Signup"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textStyle="bold"  />

    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="200dp"
        android:layout_height="180dp"
        android:layout_marginTop="25dp"
        android:layout_below="@id/signupTextView"
        android:contentDescription="Maharashtra Tourism Logo"
        android:src="@drawable/logo_image" />

    <TextView
        android:id="@+id/welcomeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logoImageView"
        android:layout_alignStart="@id/logoImageView"
        android:shadowColor="#808080"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="Welcome to"
        android:textColor="@color/colorPrimary"
        android:textSize="24sp"
        android:textStyle="bold"  />

    <TextView
        android:id="@+id/welcomeTextLine2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/welcomeTextView"
        android:layout_alignStart="@id/welcomeTextView"
        android:shadowColor="#808080"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="Maharashtra Tourism"
        android:textColor="@color/colorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"/>


    <EditText
        android:id="@+id/emailEditText"
        android:hint="Enter email id"
        android:layout_below="@id/welcomeTextLine2"
        android:inputType="textEmailAddress"
        style="@style/inputField" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_email_24"
        android:layout_alignTop="@id/emailEditText"
        android:layout_alignBottom="@id/emailEditText"
        android:alpha="1"
        android:layout_margin="5dp"/>

    <EditText
        android:id="@+id/passwordEditText"
        android:hint="Password"
        android:layout_below="@id/emailEditText"
        android:inputType="textPassword"
        style="@style/inputField" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_lock_24"
        android:layout_alignTop="@id/passwordEditText"
        android:layout_alignBottom="@id/passwordEditText"
        android:alpha="1"
        android:layout_margin="5dp"/>


    <TextView
        android:id="@+id/forgotPasswordTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_below="@id/passwordEditText"
        android:layout_alignStart="@id/passwordEditText"
        android:text="Forgot password?"
        android:textColor="@color/holo_red_dark"/>


    <!-- Login Button -->
    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/forgotPasswordTextView"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="Login"
        android:textColor="@color/white" />

</RelativeLayout>