<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:background="@color/white"
    android:layout_margin="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:layout_width="230dp"
            android:layout_height="150dp"
            android:id="@+id/destinationImage"
            android:scaleType="fitXY"
            android:src="@drawable/baseline_image_24"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_below="@id/destinationImage">

            <TextView
                android:id="@+id/destinationName"
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:gravity="center"
                android:text="Destination Name"
                android:textColor="@color/orange"
                android:textSize="16sp"
                android:padding="10dp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/likeUnlikePlace"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/transperent"
                android:contentDescription="Favorite Button"
                android:src="@drawable/baseline_favorite_border" />


        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>